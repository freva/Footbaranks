<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/filterSpinnerCountryFlag"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@string/country"
        android:layout_marginTop="6dp"
        android:layout_marginStart="4dp"
        android:layout_marginLeft="4dp"/>


    <TextView
        android:id="@+id/filterSpinnerCountryName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:text="@string/teamRanking_country_name"
        android:padding="6dp"
        android:textColor="#222"/>


    <TextView
        android:id="@+id/filterSpinnerCountryAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="@string/teamRanking_rating"
        android:textSize="16sp"
        android:padding="6dp"
        android:textColor="#666"
        android:typeface="monospace"/>
</LinearLayout>