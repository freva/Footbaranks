<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/matches_details_dialog_team_away"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="Team Away"
        android:rotation="270"
        android:layout_gravity="center"/>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/matches_details_dialog_team_home"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Team Home"
            android:layout_gravity="center"/>


        <TableLayout
            android:id="@+id/matches_details_dialog_table"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="#333">

            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_marginRight="2dp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:text="0"
                    android:layout_marginRight="2dp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:text="1"
                    android:layout_marginRight="2dp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:text="2"
                    android:layout_marginRight="2dp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:text="3"
                    android:layout_marginRight="2dp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:text="4"
                    android:layout_marginRight="2dp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:text="5"
                    android:layout_marginRight="2dp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:text="6"
                    android:layout_marginRight="2dp"
                    android:layout_marginTop="2dp"/>
            </TableRow>

            <TableRow
                android:id="@+id/matches_details_dialog_row0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="0"
                    android:layout_marginRight="2dp"
                    android:layout_marginTop="2dp"/>
            </TableRow>

            <TableRow
                android:id="@+id/matches_details_dialog_row1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="1"
                    android:layout_marginRight="2dp"
                    android:layout_marginTop="2dp"/>
            </TableRow>

            <TableRow
                android:id="@+id/matches_details_dialog_row2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="2"
                    android:layout_marginRight="2dp"
                    android:layout_marginTop="2dp"/>
            </TableRow>


            <TableRow
                android:id="@+id/matches_details_dialog_row3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="3"
                    android:layout_marginRight="2dp"
                    android:layout_marginTop="2dp"/>
            </TableRow>

            <TableRow
                android:id="@+id/matches_details_dialog_row4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="4"
                    android:layout_marginRight="2dp"
                    android:layout_marginTop="2dp"/>
            </TableRow>

            <TableRow
                android:id="@+id/matches_details_dialog_row5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="5"
                    android:layout_marginRight="2dp"
                    android:layout_marginTop="2dp"/>
            </TableRow>

            <TableRow
                android:id="@+id/matches_details_dialog_row6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="6"
                    android:layout_marginRight="2dp"
                    android:layout_marginTop="2dp"/>
            </TableRow>
        </TableLayout>
    </LinearLayout>
</LinearLayout>